# ─────────────────────────────────────────────
#  T!H$C Backend — Environment Variables
#  Copy this file to .env and fill in your values
#  NEVER commit .env to GitHub
# ─────────────────────────────────────────────

# Server
PORT=3000
NODE_ENV=development

# Session — generate a random string, keep it secret
# Run this in terminal to generate one:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=REPLACE_WITH_A_LONG_RANDOM_STRING

# Discord OAuth2
# Get these from discord.com/developers/applications
DISCORD_CLIENT_ID=1492398951779799100
DISCORD_CLIENT_SECRET=PASTE_YOUR_NEW_SECRET_HERE

# Change this to your Render URL once deployed
# Local: http://localhost:3000/auth/discord/callback
# Production: https://your-app.railway.app/auth/discord/callback
DISCORD_CALLBACK_URL=http://localhost:3000/auth/discord/callback

# Your Discord User ID — you are the owner, always have access
OWNER_DISCORD_ID=332059572523237386

# Public site URL (your Netlify site)
PUBLIC_SITE_URL=https://thehoustonclutchers.netlify.app

# Discord Webhook URL for form notifications (optional)
# Create one in your Discord server: Channel Settings → Integrations → Webhooks
DISCORD_WEBHOOK_URL=
